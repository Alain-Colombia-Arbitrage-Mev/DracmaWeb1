{
  "name": "dracmaweb1-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "api": "node server/index.mjs",
    "dev:api": "node --watch server/index.mjs",
    "build": "astro build && node scripts/build-locales.mjs",
    "test:amplify-hosting": "node --test amplify-hosting.test.mjs",
    "test:min-purchase": "node --test server/minPurchase.test.mjs",
    "test:nowpayments-service": "node --test src/services/nowPaymentsService.test.mjs",
    "test:no-ai-cta": "node --test src/components/no-ai-cta.test.mjs",
    "test:presale-nowpayments": "node --test src/components/react/Presale.nowpayments.test.mjs",
    "test:huff": "node --test contracts/test/TokenDistributor.huff.test.mjs",
    "deploy:huff:distributor": "node contracts/script/deployTokenDistributor.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:pages": "npm run build && npm run verify:pages && npm run verify:seo && npm run verify:publication && npm run verify:locales && node scripts/prepare-pages.mjs && npx --yes wrangler@4.151.1 pages deploy dist --project-name dracmaweb1",
    "verify:publication": "node scripts/verify-project-publication.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:seo:live": "node scripts/verify-seo.mjs --live --external",
    "verify:locales": "node scripts/verify-locales.mjs",
    "test:token-estimate": "node --test src/services/tokenEstimate.test.mjs",
    "test:project-fees": "node --test scripts/project-fees.test.mjs",
    "simulate:project-fees": "node scripts/simulate-project-fees.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@google/genai": "^1.40.0",
    "@nanostores/react": "^1.0.0",
    "@tanstack/react-query": "^5.90.20",
    "astro": "^6.4.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nanostores": "^1.1.0",
    "parse5": "7.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.182.0",
    "viem": "^2.45.2",
    "wagmi": "^3.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "tailwindcss": "^4.1.18"
  }
}
