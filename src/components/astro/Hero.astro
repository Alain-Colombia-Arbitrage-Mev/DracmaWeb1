---
import { getTranslationsForLang } from '../../i18n/utils';
import { getVisualCopy } from '../../data/visual';
interface Props { lang: string; }
const { lang } = Astro.props;
const t = getTranslationsForLang(lang);
const v = getVisualCopy(lang);
---
<section id="hero" class="landing-hero">
  <div class="hero-grid max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="hero-copy">
      <p class="editorial-eyebrow"><span></span>{v.eyebrow}</p>
      <h1>{t['heroTitlePhoenix'] || 'El Futuro del Valor, Hoy.'}</h1>
      <p class="hero-description">{t['heroSubtitle']}</p>
      <div class="hero-actions">
        <a href="#presale" class="btn-primary">{t['btnJoinPresale']} <span aria-hidden="true">↗</span></a>
        <a href="#ecosystem" class="hero-text-link">{t['btnExplore']} <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-network"><span class="network-mark" aria-hidden="true">◇</span><span>{v.network}</span><span class="network-standard">BEP–20</span></div>
    </div>
    <div class="hero-visual">
      <figure class="hero-main-photo">
        <img src="/images/solar.webp" srcset="/images/solar-640.webp 640w, /images/solar.webp 1280w" sizes="(max-width: 767px) 90vw, 520px" alt={v.photoAlt} width="1600" height="1067" fetchpriority="high" decoding="async" />
        <figcaption><span>{v.photo}</span><span aria-hidden="true">01 / DRACMA</span></figcaption>
      </figure>
      <div class="hero-brand-plaque">
        <img src="/brand/dracma-eagle.webp" alt="" width="64" height="74" />
        <div><span class="plaque-label">DRACMA</span><p>{v.solar}</p></div>
        <a href="#ecosystem" aria-label={v.explore} class="plaque-arrow">↗</a>
      </div>
      <figure class="hero-inset-photo"><img src="/images/agriculture-640.webp" alt={v.farmAlt} width="320" height="220" decoding="async" /><figcaption>{v.agriculture}</figcaption></figure>
    </div>
  </div>
  <div class="hero-bottom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <span class="hero-bottom-wordmark">DRACMA <span>ECOSYSTEM</span></span>
    <a href="#ecosystem">{v.explore}<span aria-hidden="true">↓</span></a>
  </div>
</section>
