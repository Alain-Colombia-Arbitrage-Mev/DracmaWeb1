---
import DracmaChat from '../react/DracmaChat';
import {canvasAppearance} from '../../lib/canvas-appearance.mjs';
import BuyPage from './BuyPage.astro';
const {page}=Astro.props;
const files=import.meta.glob('/src/designs/*.html',{query:'?raw',import:'default',eager:true});
const desktop=files[`/src/designs/${page.id}.html`];
const mobile=page.mobile?files[`/src/designs/${page.mobile}.html`]:null;
if(!desktop)throw new Error(`Missing Pencil screen ${page.id}`);
---
{page.slug==='comprar'?<BuyPage/>:<>
<div class:list={['pencil-desktop',{'has-mobile':mobile}]}><Fragment set:html={canvasAppearance(desktop)}/></div>
{mobile&&<div class="pencil-mobile"><Fragment set:html={canvasAppearance(mobile)}/></div>}
</>}

{page.id==='jneec'&&<div data-dracma-chat-root><DracmaChat client:load/></div>}
