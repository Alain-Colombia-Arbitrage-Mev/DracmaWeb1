---
import PencilLayout from '../../layouts/PencilLayout.astro';
import ProjectDisclosure from '../../components/pencil/ProjectDisclosure.astro';
import CanvasPage from '../../components/pencil/CanvasPage.astro';
import projects from '../../data/pencil-projects.json';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project:p}=Astro.props;
---
<PencilLayout title={p.name} description={`${p.name}: proyecto de ${p.sector.toLowerCase()} en ${p.country}. Consulta objetivos, uso del capital, riesgos y condiciones. Ficha ilustrativa.`} image={p.photo}>
<ProjectDisclosure/>
{p.slug==='atacama-ii'?<CanvasPage page={{id:'C2sAT'}}/>:<>
 <header class="mx-auto max-w-[1180px] px-5 py-16"><a href="/proyectos/" class="text-sm text-[#BBCBCD]">← Todos los proyectos</a><p class="mt-10 text-xs tracking-widest text-[#E6FF28]">FICHA ILUSTRATIVA · {p.sector.toUpperCase()} / {p.country.toUpperCase()}</p><h1 class="mt-4 max-w-4xl font-display text-5xl font-black leading-none md:text-6xl">{p.name.toUpperCase()}</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#DCE6E4]">Concepto no verificado: {p.summary}</p></header>
 <section class="bg-white py-16 text-[#0C2730]"><div class="mx-auto grid max-w-[1180px] gap-10 px-5 lg:grid-cols-[1.3fr_1fr]"><div>{p.photo&&<img src={p.photo} alt={`Fotografía ilustrativa para ${p.name}`} width="800" height="480" class="mb-8 aspect-[5/3] w-full rounded-md object-cover"/>}<h2 class="font-display text-3xl font-black">CONCEPTO DEL PROYECTO · EJEMPLO</h2><p class="mt-5 leading-8 text-[#50666D]">{p.about}</p><h2 class="mt-10 font-display text-3xl font-black">DISTRIBUCIÓN DEL CAPITAL · EJEMPLO</h2>{p.use.map(([name,percent])=><div class="mt-4 flex justify-between gap-4 border-b border-[#D9E2E3] pb-3"><span>{name}</span><strong>{percent}%</strong></div>)}<h2 class="mt-10 font-display text-3xl font-black">RIESGOS DEL PROYECTO</h2><ul class="mt-5 list-disc space-y-3 pl-5 text-sm leading-7 text-[#50666D]">{p.risks.map(r=><li>{r}</li>)}</ul></div><aside class="self-start rounded-lg border border-[#71868B] p-7"><p class="text-xs tracking-widest">FICHA CONCEPTUAL · NO ES UNA OFERTA</p><h2 class="mt-5 font-display text-3xl font-bold">SIN APORTES HABILITADOS</h2><dl class="mt-8 space-y-4" data-project-publication-status>{[['Estado','Concepto ilustrativo'],['Contrato del proyecto','Dirección verificada no publicada'],['Recaudación','Sin datos verificados'],['Condiciones económicas','No publicadas'],['Calendario','Sin fechas verificadas']].map(([a,b])=><div class="flex flex-col gap-2 border-b border-[#D9E2E3] pb-3 text-sm"><dt>{a}</dt><dd class="font-medium leading-6">{b}</dd></div>)}</dl><a href={`/empezar/?interes=Proyectos`} class="pencil-button mt-8 w-full">Recibir información →</a><p class="mt-4 text-xs leading-6 text-[#50666D]">Proyecto ilustrativo. No se aceptan aportes desde esta ficha. Las condiciones y documentos definitivos deben estar disponibles antes de participar.</p></aside></div></section>
 </>}
</PencilLayout>
