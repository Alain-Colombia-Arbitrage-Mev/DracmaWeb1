---
import Navigation from '../components/pencil/Navigation.astro';
import Footer from '../components/pencil/Footer.astro';
import '../styles/pencil.css';
const {title='Proyectos reales. Cada dólar, visible.',compact=false}=Astro.props;
---
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · dracma</title><meta name="description" content="Tokenización de proyectos, comisiones claras y contabilidad abierta. Explora dracma y consulta las condiciones de cada operación."/><meta name="theme-color" content="#000000"/><link rel="icon" type="image/png" href="/favicon.png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Roboto+Condensed:wght@500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet"/><meta property="og:title" content={`${title} · dracma`}/><meta property="og:type" content="website"/><meta property="og:image" content="https://dracmaweb1.pages.dev/brand/dracma-eagle.png"/></head><body><a class="skip-link" href="#main-content">Saltar al contenido</a><Navigation compact={compact}/><main id="main-content"><slot/></main><Footer/><script>import '../scripts/pencil';</script></body></html>
